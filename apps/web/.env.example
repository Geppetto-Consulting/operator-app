VITE_API_BASE_URL="http://localhost:8000"

VITE_WEB_BASE_URL="http://localhost:3000"

VITE_ADMIN_BASE_URL="http://localhost:3001"
VITE_ADMIN_BASE_PATH="/god-mode"

VITE_SPACE_BASE_URL="http://localhost:3002"
VITE_SPACE_BASE_PATH="/spaces"

VITE_LIVE_BASE_URL="http://localhost:3100"
VITE_LIVE_BASE_PATH="/live"

# [ours: module-shaped dashboards / ENG-196 / ENG-197] operator-mcp endpoint.
# operator-mcp is the per-workspace MCP server that serves dashboard widget
# data from connectors (gcal, gmail, …). Local-dev default below; set both
# in production. The bearer is the per-workspace mcp-bearer (matches the
# workspace-tokens.json key on the mcp-server side). Phase 1 embeds it at
# build time; Phase 3+ may proxy server-side.
VITE_OPERATOR_MCP_BASE_URL="http://localhost:8723"
VITE_OPERATOR_MCP_BEARER=""
